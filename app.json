{
  "expo": {
    "name": "Son Işık",
    "slug": "son-isik-3d",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "sonisik",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050914"
    },
    "android": {
      "package": "com.onurforce.sonisik",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050914"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": ["expo-router"]
  }
}
